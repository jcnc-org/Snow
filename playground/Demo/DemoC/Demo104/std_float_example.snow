/**
 * @module std_float_example
 * @summary std_float 方法演示
 */
module: std_float_example

    import: std_float
    import: std_math
    import: std_io
    import: std_parse
    import: std_option

    function: main
        body:
            std_io.println("=== 构造与拆箱 floatValue() ===")
            declare defaultfloat: std_float.Float = new std_float.Float()
            declare pifloat: std_float.Float = new std_float.Float(3.14f)
            std_io.println("默认构造 -> " + defaultfloat.floatValue())
            std_io.println("带参构造(3.14f) -> " + pifloat.floatValue())

            std_io.println("\n=== valueOf* 与静态 toString() ===")
            declare boxedFromfloat: std_float.Float = std_float.valueOf(42.5f)
            declare boxedFromString: std_float.Float = std_float.valueOfString("12.34")
            std_io.println("valueOf(42.5f) -> " + boxedFromfloat.floatValue())
            std_io.println("valueOfString(\"12.34\") -> " + boxedFromString.floatValue())
            std_io.println("std_float.toString(7.5f) -> " + std_float.toString(7.5f))

            std_io.println("\n=== 实例方法 abs()/equals()/toString() ===")
            declare negfloat: std_float.Float = new std_float.Float(-120f)
            declare eqA: std_float.Float = new std_float.Float(10f)
            declare eqB: std_float.Float = new std_float.Float(10f)
            declare eqC: std_float.Float = new std_float.Float(8f)
            std_io.println("abs(-120f) -> " + negfloat.abs().floatValue())
            std_io.println("equals(10f,10f) -> " + eqA.equals(eqB))
            std_io.println("equals(10f,8f) -> " + eqA.equals(eqC))
            std_io.println("toString() on 10f -> " + eqA.toString())

            std_io.println("\n=== 数学/解析工具 ===")
            std_io.println("std_parse.parseFloat(\"-71.25\") -> " + std_parse.parseFloat("-71.25"))

            declare trimmed: std_option.OptionFloat = std_parse.tryParseFloat("   +12.5  ")
            if trimmed.isSome() then
                std_io.println("tryParseFloat(\"   +12.5  \") -> Some(" + trimmed.value + ")")
            else
                std_io.println("tryParseFloat(\"   +12.5  \") -> None")
            end if

            declare invalid: std_option.OptionFloat = std_parse.tryParseFloat("oops")
            if invalid.isSome() then
                std_io.println("tryParseFloat(\"oops\") -> Some(" + invalid.value + ")")
            else
                std_io.println("tryParseFloat(\"oops\") -> None")
            end if

            std_io.println("std_math.compareFloat(1.2f, 5.0f) -> " + std_math.compareFloat(1.2f, 5.0f))
            std_io.println("std_math.compareFloat(7.0f, 2.0f) -> " + std_math.compareFloat(7.0f, 2.0f))
            std_io.println("std_math.maxFloat(-15f, 20f) -> " + std_math.maxFloat(-15f, 20f))
            std_io.println("std_math.minFloat(-15f, 20f) -> " + std_math.minFloat(-15f, 20f))

            std_io.println("\n=== 常量 MIN_VALUE / MAX_VALUE ===")
            std_io.println("MIN_VALUE: " + std_float.MIN_VALUE)
            std_io.println("MAX_VALUE: " + std_float.MAX_VALUE)

        end body
    end function

end module