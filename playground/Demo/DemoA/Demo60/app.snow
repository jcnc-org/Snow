module: app
    import: fs
    import: fd
    import: std_io.fs
    import: fs
    import: fd
    import: std_io.fd
    import: std_io
    import: os_fs

    function: main
        params:
            declare args: any
        body:
            fs.mkdir("demoDir", 0)
            std_io.println("已创建 demoDir")

            fs.chmod("demoDir", 493)
            std_io.println("已修改 demoDir 权限为 755")

            os_fs.removeDir("demoDir")
        end body
    end function
end module
