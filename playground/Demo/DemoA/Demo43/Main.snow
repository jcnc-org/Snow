module: app
    import: fs
    import: fd
    import: syscall.io
    import: std_io

    function: main
        params:
            declare args: any
        body:
            declare ret: int

            // 向标准错误输出写一条消息
            ret = io.stderrWrite("这是错误信息！")
            ret = io.stderrWrite("\n")

            // 打印返回值，正常情况下是 0
            std_io.println("stderrWrite 返回值: " + ret)
        end body
    end function
end module
