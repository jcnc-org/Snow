module: app
    import: io
    import: process

    function: main
        params:
            declare args: any
        body:
            declare pid: int = process.getPid()
            declare ppid: int = process.getPpid()

            io.stdoutWrite("当前进程 PID = " + pid + "\n")
            io.stdoutWrite("父进程 PPID = " + ppid + "\n")
        end body
    end function
end module
