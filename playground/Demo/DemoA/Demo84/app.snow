module: app
    import: time
    import: std_io

    function: main
        body:
            std_io.println("nowNs=" + time.nowNs())
            std_io.println("nowMs=" + time.nowMs())
            std_io.println("monoMs=" + time.monoMs())
            std_io.println("tickMs=" + time.tickMs())

            std_io.println("epoch_sec=" + time.epoch_sec())
            std_io.println("epoch_usec_in_sec=" + time.epoch_usec_in_sec())

            std_io.println("sleep 10ms ...")
            time.sleepMs(10)
            std_io.println("awake")
        end body
    end function
end module