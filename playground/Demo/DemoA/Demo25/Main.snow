module: main
    import: std_io
    import: module_a
    globals:
        declare c: int = 10
    function: main
        returns: void
        body:
            c = module_a.getA()
            std_io.print(c)
        end body
    end function
end module

module: module_a
    globals:
        declare a: int = 2
    function: getA
        returns: int
        body:
            return a
        end body
    end function
end module
