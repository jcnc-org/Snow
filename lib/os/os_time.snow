/**
@module os_time
@summary 时间与睡眠工具，基于 syscall.time 的稳定封装。
*/
module: os_time

    import: time

    /**
    @function nowNs
    @summary 返回墙钟时间（纳秒）。
    */
    function: nowNs
        returns: long
        body:
            return time.nowNs()
        end body
    end function

    /**
    @function nowMs
    @summary 返回墙钟时间（毫秒）。
    */
    function: nowMs
        returns: long
        body:
            return time.nowMs()
        end body
    end function

    /**
    @function monoNs
    @summary 返回单调时钟（纳秒）。
    */
    function: monoNs
        returns: long
        body:
            return time.monoNs()
        end body
    end function

    /**
    @function monoMs
    @summary 返回单调时钟（毫秒）。
    */
    function: monoMs
        returns: long
        body:
            return time.monoMs()
        end body
    end function

    /**
    @function sleepMs
    @summary 挂起当前线程指定毫秒。
    */
    function: sleepMs
        params:
            declare ms: int
        returns: int
        body:
            return time.sleepMs(ms)
        end body
    end function

    /**
    @function sleepUs
    @summary 挂起当前线程指定微秒。
    */
    function: sleepUs
        params:
            declare us: int
        returns: int
        body:
            return time.sleepUs(us)
        end body
    end function

    /**
    @function sleepNs
    @summary 挂起当前线程指定纳秒。
    */
    function: sleepNs
        params:
            declare ns: long
        returns: int
        body:
            return time.sleepNs(ns)
        end body
    end function

    /**
    @function tickMs
    @summary 返回单调计数（毫秒）。
    */
    function: tickMs
        returns: long
        body:
            return time.tickMs()
        end body
    end function

end module
