/**
@module os_bytes
@summary Bytes 的过程式稳定层。
*/
module: os_bytes

    import: bytes

    function: length
        params:
            declare data: byte[]
        returns: int
        body:
            return bytes.length(data)
        end body
    end function

    function: get
        params:
            declare data: byte[]
            declare idx: int
        returns: byte
        body:
            return bytes.get(data, idx)
        end body
    end function

    function: set
        params:
            declare data: byte[]
            declare idx: int
            declare b: byte
        returns: int
        body:
            return bytes.set(data, idx, b)
        end body
    end function

    function: alloc
        params:
            declare n: int
        returns: byte[]
        body:
            return bytes.alloc(n)
        end body
    end function

    function: concat
        params:
            declare a: byte[]
            declare b: byte[]
        returns: byte[]
        body:
            return bytes.concat(a, b)
        end body
    end function

end module