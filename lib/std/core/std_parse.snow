/**
@module std_parse
@summary 字符串解析工具集，提供基础的类型转换能力。
*/
module: std_parse
    import: os_fd
    import: std_string
    import: std_array
    import: std_option
    import: std_bytes

    /**
    @function _digitValue
    @summary 将单字符转为对应的数字，非数字返回 -1
    */
    function: _digitValue
        params:
            declare ch: int
        returns: int
        body:
            if ch >= 48 && ch <= 57 then   // '0'..'9'
                return ch - 48
            end if
            return -1
        end body
    end function

    /**
    @function _digitValueRadix
    @summary 支持 0-9A-Za-z 的数字解析，返回 -1 表示无效。
    */
    function: _digitValueRadix
        params:
            declare ch: int
        returns: int
        body:
            if ch >= 48 && ch <= 57 then              // '0'..'9'
                return ch - 48
            end if
            if ch >= 65 && ch <= 90 then              // 'A'..'Z'
                return 10 + (ch - 65)
            end if
            if ch >= 97 && ch <= 122 then             // 'a'..'z'
                return 10 + (ch - 97)
            end if
            return -1
        end body
    end function

    /**
    @function _isWhitespace
    @summary 判断是否为空白字符（space/tab/lf/cr）
    */
    function: _isWhitespace
        params:
            declare ch: int
        returns: boolean
        body:
            if ch == 32 || ch == 9 || ch == 10 || ch == 13 then
                return true
            end if
            return false
        end body
    end function

    /**
    @function _skipLeadingWhitespace
    @summary 返回跳过前导空白后的索引。
    */
    function: _skipLeadingWhitespace
        params:
            declare data: byte[]
            declare len: int
            declare startIdx: int
        returns: int
        body:
            declare idx: int = startIdx
            loop:
                init:
                    idx = idx
                cond:
                    idx < len
                step:
                    idx = idx
                body:
                    declare b: int = std_parse._arrGet(data, idx)
                    if std_parse._isWhitespace(b) == false then
                        break
                    end if
                    idx = idx + 1
                end body
            end loop
            return idx
        end body
    end function

    /**
    @function _consumeTrailingWhitespace
    @summary 若剩余部分均为空白则返回 true。
    */
    function: _consumeTrailingWhitespace
        params:
            declare data: byte[]
            declare len: int
            declare idx: int
        returns: boolean
        body:
            declare pos: int = idx
            loop:
                init:
                    pos = pos
                cond:
                    pos < len
                step:
                    pos = pos
                body:
                    declare b: int = std_parse._arrGet(data, pos)
                    if std_parse._isWhitespace(b) == false then
                        return false
                    end if
                    pos = pos + 1
                end body
            end loop
            return true
        end body
    end function

    /**
    @function _validateRadix
    @summary 检查进制范围（2~36）。
    */
    function: _validateRadix
        params:
            declare radix: int
        returns: boolean
        body:
            if radix < 2 || radix > 36 then
                return false
            end if
            return true
        end body
    end function

    /**
    @function _tryParseIntCore
    @summary 内部核心：按进制解析为 int，严格失败。
    */
    function: _tryParseIntCore
        params:
            declare s: string
            declare radix: int
        returns: std_option.OptionInt
        body:
            if std_parse._validateRadix(radix) == false then
                return std_option.noneInt()
            end if

            declare data: byte[] = std_string.toBytes(s)
            declare len: int = std_parse._arrLen(data)
            declare idx: int = std_parse._skipLeadingWhitespace(data, len, 0)
            if idx >= len then
                return std_option.noneInt()
            end if

            declare negative: boolean = false
            declare first: int = std_parse._arrGet(data, idx)
            if first == 45 then          // '-'
                negative = true
                idx = idx + 1
            else
                if first == 43 then      // '+'
                    idx = idx + 1
                end if
            end if

            declare hasDigit: boolean = false
            declare value: int = 0

            declare pos: int = idx
            loop:
                init:
                    pos = pos
                cond:
                    pos < len
                step:
                    pos = pos
                body:
                    declare cur: int = std_parse._arrGet(data, pos)
                    declare digit: int = std_parse._digitValueRadix(cur)
                    if digit == -1 || digit >= radix then
                        break
                    end if
                    hasDigit = true
                    value = value * radix + digit
                    pos = pos + 1
                end body
            end loop

            if hasDigit == false then
                return std_option.noneInt()
            end if

            if std_parse._consumeTrailingWhitespace(data, len, pos) == false then
                return std_option.noneInt()
            end if

            if negative then
                value = -value
            end if

            return std_option.someInt(value)
        end body
    end function

    /**
    @function _tryParseLongCore
    @summary 内部核心：按进制解析为 long，严格失败。
    */
    function: _tryParseLongCore
        params:
            declare s: string
            declare radix: int
        returns: std_option.OptionLong
        body:
            if std_parse._validateRadix(radix) == false then
                return std_option.noneLong()
            end if

            declare data: byte[] = std_string.toBytes(s)
            declare len: int = std_parse._arrLen(data)
            declare idx: int = std_parse._skipLeadingWhitespace(data, len, 0)
            if idx >= len then
                return std_option.noneLong()
            end if

            declare negative: boolean = false
            declare first: int = std_parse._arrGet(data, idx)
            if first == 45 then
                negative = true
                idx = idx + 1
            else
                if first == 43 then
                    idx = idx + 1
                end if
            end if

            declare hasDigit: boolean = false
            declare value: long = 0L

            declare pos: int = idx
            loop:
                init:
                    pos = pos
                cond:
                    pos < len
                step:
                    pos = pos
                body:
                    declare cur: int = std_parse._arrGet(data, pos)
                    declare digit: int = std_parse._digitValueRadix(cur)
                    if digit == -1 || digit >= radix then
                        break
                    end if
                    hasDigit = true
                    value = value * radix + (digit * 1L)
                    pos = pos + 1
                end body
            end loop

            if hasDigit == false then
                return std_option.noneLong()
            end if

            if std_parse._consumeTrailingWhitespace(data, len, pos) == false then
                return std_option.noneLong()
            end if

            if negative then
                value = -value
            end if

            return std_option.someLong(value)
        end body
    end function

    /**
    @function _tryParseFloatCore
    @summary 内部核心：严格解析 float。
    */
    function: _tryParseFloatCore
        params:
            declare s: string
        returns: std_option.OptionFloat
        body:
            declare data: byte[] = std_string.toBytes(s)
            declare len: int = std_parse._arrLen(data)
            declare idx: int = std_parse._skipLeadingWhitespace(data, len, 0)
            if idx >= len then
                return std_option.noneFloat()
            end if

            declare negative: boolean = false
            declare first: int = std_parse._arrGet(data, idx)
            if first == 45 then      // '-'
                negative = true
                idx = idx + 1
            else
                if first == 43 then
                    idx = idx + 1
                end if
            end if

            declare hasDigit: boolean = false
            declare intPart: float = 0.0f

            declare pos: int = idx
            loop:
                init:
                    pos = pos
                cond:
                    pos < len
                step:
                    pos = pos
                body:
                    declare cur: int = std_parse._arrGet(data, pos)
                    declare digit: int = std_parse._digitValue(cur)
                    if digit == -1 then
                        break
                    end if
                    hasDigit = true
                    intPart = intPart * 10.0f + (digit * 1.0f)
                    pos = pos + 1
                end body
            end loop

            declare fracPart: float = 0.0f
            declare fracBase: float = 0.1f

            if pos < len then
                declare dot: int = std_parse._arrGet(data, pos)
                if dot == 46 then
                    pos = pos + 1
                    declare fpos: int = pos
                    loop:
                        init:
                            fpos = fpos
                        cond:
                            fpos < len
                        step:
                            fpos = fpos
                        body:
                            declare cur: int = std_parse._arrGet(data, fpos)
                            declare digit: int = std_parse._digitValue(cur)
                            if digit == -1 then
                                break
                            end if
                            hasDigit = true
                            fracPart = fracPart + (digit * fracBase)
                            fracBase = fracBase * 0.1f
                            fpos = fpos + 1
                        end body
                    end loop
                    pos = fpos
                end if
            end if

            if hasDigit == false then
                return std_option.noneFloat()
            end if

            if std_parse._consumeTrailingWhitespace(data, len, pos) == false then
                return std_option.noneFloat()
            end if

            declare result: float
            if negative then
                result = -intPart
                result = result - fracPart
            else
                result = intPart + fracPart
            end if

            return std_option.someFloat(result)
        end body
    end function

    /**
    @function _tryParseDoubleCore
    @summary 内部核心：严格解析 double。
    */
    function: _tryParseDoubleCore
        params:
            declare s: string
        returns: std_option.OptionDouble
        body:
            declare data: byte[] = std_string.toBytes(s)
            declare len: int = std_parse._arrLen(data)
            declare idx: int = std_parse._skipLeadingWhitespace(data, len, 0)
            if idx >= len then
                return std_option.noneDouble()
            end if

            declare negative: boolean = false
            declare first: int = std_parse._arrGet(data, idx)
            if first == 45 then       // '-'
                negative = true
                idx = idx + 1
            else
                if first == 43 then   // '+'
                    idx = idx + 1
                end if
            end if

            declare hasDigit: boolean = false
            declare intPart: double = 0.0

            declare pos: int = idx
            loop:
                init:
                    pos = pos
                cond:
                    pos < len
                step:
                    pos = pos
                body:
                    declare cur: int = std_parse._arrGet(data, pos)
                    declare digit: int = std_parse._digitValue(cur)
                    if digit == -1 then
                        break
                    end if
                    hasDigit = true
                    intPart = intPart * 10.0 + digit
                    pos = pos + 1
                end body
            end loop

            declare fracPart: double = 0.0
            declare fracBase: double = 0.1

            if pos < len then
                declare dot: int = std_parse._arrGet(data, pos)
                if dot == 46 then        // '.'
                    pos = pos + 1
                    declare fpos: int = pos
                    loop:
                        init:
                            fpos = fpos
                        cond:
                            fpos < len
                        step:
                            fpos = fpos
                        body:
                            declare cur: int = std_parse._arrGet(data, fpos)
                            declare digit: int = std_parse._digitValue(cur)
                            if digit == -1 then
                                break
                            end if
                            hasDigit = true
                            fracPart = fracPart + (digit * fracBase)
                            fracBase = fracBase * 0.1
                            fpos = fpos + 1
                        end body
                    end loop
                    pos = fpos
                end if
            end if

            if hasDigit == false then
                return std_option.noneDouble()
            end if

            if std_parse._consumeTrailingWhitespace(data, len, pos) == false then
                return std_option.noneDouble()
            end if

            declare result: double
            if negative then
                result = -intPart
                result = result - fracPart
            else
                result = intPart + fracPart
            end if

            return std_option.someDouble(result)
        end body
    end function

    /**
    @function _arrLen
    @summary 内部工具：获取字节数组长度（基于 std_bytes）
    */
    function: _arrLen
        params:
            declare data: byte[]
        returns: int
        body:
            return std_bytes.length(data)
        end body
    end function

    /**
    @function _arrGet
    @summary 内部工具：获取字节数组元素（基于 std_bytes）
    */
    function: _arrGet
        params:
            declare data: byte[]
            declare idx: int
        returns: int
        body:
            return std_bytes.get(data, idx)
        end body
    end function

    /**
    @function parseDouble
    @summary 将字符串解析为 double（容错：失败返回 0）
    @description 使用管道转为字节数组，支持前导空白、可选符号与小数部分。
    */
    function: parseDouble
        params:
            declare s: string
        returns: double
        body:
            declare opt: std_option.OptionDouble = std_parse.tryParseDouble(s)
            if opt.isSome() then
                return opt.value
            end if
            return 0
        end body
    end function

    /**
    @function tryParseDouble
    @summary 严格解析 double，成功返回 Some，失败返回 None。
    */
    function: tryParseDouble
        params:
            declare s: string
        returns: std_option.OptionDouble
        body:
            return std_parse._tryParseDoubleCore(s)
        end body
    end function

    /**
    @function parseFloat
    @summary 将字符串解析为 float（容错：失败返回 0f）
    @description 使用管道转为字节数组。
    */
    function: parseFloat
        params:
            declare s: string
        returns: float
        body:
            declare opt: std_option.OptionFloat = std_parse.tryParseFloat(s)
            if opt.isSome() then
                return opt.value
            end if
            return 0f
        end body
    end function

    /**
    @function tryParseFloat
    @summary 严格解析 float，成功返回 Some，失败返回 None。
    */
    function: tryParseFloat
        params:
            declare s: string
        returns: std_option.OptionFloat
        body:
            return std_parse._tryParseFloatCore(s)
        end body
    end function

    /**
    @function parseLong
    @summary 将字符串解析为 long（容错：失败返回 0L）
    @description 使用管道转为字节数组。
    */
    function: parseLong
        params:
            declare s: string
        returns: long
        body:
            return std_parse.parseLongRadix(s, 10)
        end body
    end function

    /**
    @function parseLongRadix
    @summary 指定进制解析 long（容错：失败返回 0L）
    */
    function: parseLongRadix
        params:
            declare s: string
            declare radix: int
        returns: long
        body:
            declare opt: std_option.OptionLong = std_parse.tryParseLongRadix(s, radix)
            if opt.isSome() then
                return opt.value
            end if
            return 0L
        end body
    end function

    /**
    @function tryParseLong
    @summary 严格解析 long，成功返回 Some，失败返回 None。
    */
    function: tryParseLong
        params:
            declare s: string
        returns: std_option.OptionLong
        body:
            return std_parse.tryParseLongRadix(s, 10)
        end body
    end function

    /**
    @function tryParseLongRadix
    @summary 指定进制严格解析 long，成功返回 Some/None。
    */
    function: tryParseLongRadix
        params:
            declare s: string
            declare radix: int
        returns: std_option.OptionLong
        body:
            return std_parse._tryParseLongCore(s, radix)
        end body
    end function




    /**
    @function parseShort
    @summary 将字符串解析为 short（容错：失败返回 0）
    @description 使用管道转为字节数组。
    */
    function: parseShort
        params:
            declare s: string
        returns: short
        body:
            return std_parse.parseShortRadix(s, 10)
        end body
    end function

    /**
    @function parseShortRadix
    @summary 指定进制解析 short（容错：失败返回 0）
    */
    function: parseShortRadix
        params:
            declare s: string
            declare radix: int
        returns: short
        body:
            declare opt: std_option.OptionShort = std_parse.tryParseShortRadix(s, radix)
            if opt.isSome() then
                return opt.value
            end if
            return 0
        end body
    end function

    /**
    @function tryParseShort
    @summary 严格解析 short，成功返回 Some，失败返回 None。
    */
    function: tryParseShort
        params:
            declare s: string
        returns: std_option.OptionShort
        body:
            return std_parse.tryParseShortRadix(s, 10)
        end body
    end function

    /**
    @function tryParseShortRadix
    @summary 指定进制严格解析 short，成功返回 Some/None。
    */
    function: tryParseShortRadix
        params:
            declare s: string
            declare radix: int
        returns: std_option.OptionShort
        body:
            declare optInt: std_option.OptionInt = std_parse._tryParseIntCore(s, radix)
            if optInt.isNone() then
                return std_option.noneShort()
            end if
            declare temp: int = optInt.value
            if temp < -32768 || temp > 32767 then
                return std_option.noneShort()
            end if
            declare result: short = temp
            return std_option.someShort(result)
        end body
    end function

    /**
    @function parseInt
    @summary 将字符串解析为 int（容错：失败返回 0）
    @description 使用管道转为字节数组。
    */
    function: parseInt
        params:
            declare s: string
        returns: int
        body:
            return std_parse.parseIntRadix(s, 10)
        end body
    end function

    /**
    @function parseIntRadix
    @summary 指定进制解析 int（容错：失败返回 0）
    */
    function: parseIntRadix
        params:
            declare s: string
            declare radix: int
        returns: int
        body:
            declare opt: std_option.OptionInt = std_parse.tryParseIntRadix(s, radix)
            if opt.isSome() then
                return opt.value
            end if
            return 0
        end body
    end function

    /**
    @function tryParseInt
    @summary 严格解析 int，成功返回 Some，失败返回 None。
    */
    function: tryParseInt
        params:
            declare s: string
        returns: std_option.OptionInt
        body:
            return std_parse.tryParseIntRadix(s, 10)
        end body
    end function

    /**
    @function tryParseIntRadix
    @summary 指定进制严格解析 int，成功返回 Some/None。
    */
    function: tryParseIntRadix
        params:
            declare s: string
            declare radix: int
        returns: std_option.OptionInt
        body:
            return std_parse._tryParseIntCore(s, radix)
        end body
    end function

    /**
    @function parseByte
    @summary 将字符串解析为 byte（容错：失败返回 0）
    @description 使用管道转为字节数组。
    */
    function: parseByte
        params:
            declare s: string
        returns: byte
        body:
            return std_parse.parseByteRadix(s, 10)
        end body
    end function

    /**
    @function parseByteRadix
    @summary 指定进制解析 byte（容错：失败返回 0）
    */
    function: parseByteRadix
        params:
            declare s: string
            declare radix: int
        returns: byte
        body:
            declare opt: std_option.OptionByte = std_parse.tryParseByteRadix(s, radix)
            if opt.isSome() then
                return opt.value
            end if
            return 0
        end body
    end function

    /**
    @function tryParseByte
    @summary 严格解析 byte，成功返回 Some，失败返回 None。
    */
    function: tryParseByte
        params:
            declare s: string
        returns: std_option.OptionByte
        body:
            return std_parse.tryParseByteRadix(s, 10)
        end body
    end function

    /**
    @function tryParseByteRadix
    @summary 指定进制严格解析 byte，成功返回 Some/None。
    */
    function: tryParseByteRadix
        params:
            declare s: string
            declare radix: int
        returns: std_option.OptionByte
        body:
            declare optInt: std_option.OptionInt = std_parse._tryParseIntCore(s, radix)
            if optInt.isNone() then
                return std_option.noneByte()
            end if
            declare temp: int = optInt.value
            if temp < -128 || temp > 127 then
                return std_option.noneByte()
            end if
            declare result: byte = temp
            return std_option.someByte(result)
        end body
    end function


end module